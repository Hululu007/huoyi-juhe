/release-archives/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
/android/build/
/android/app/.cxx/

# Rust 原生核心（rust/）的构建输出。/android/app/src/main/jniLibs/*/*.so 已在下面忽略，
# 因此 Rust ARM64 库同样不入库，由 scripts/build_rust_backend.ps1 / .sh 重建。
/rust/target/

# Rust 原生核心（rust/）与 C 加密库都可由源码重建，不提交生成的 .so。
# shortplay 加密库由 native/ 中的 C 源码通过 CMake 构建。
# 例外：下面三个 TDLib 预编译库没有源码、仓里重建不了（Telegram X
# 改名后的 OpenSSL + TDLib JNI），缺了它们应用内 TDLib 登录直接报
# libcryptox.so not found，必须入库，Gradle 才会打进 APK 的 lib/ 里。
/assets/config/device_pool.json
/android/app/src/main/jniLibs/*/*.so
!/android/app/src/main/jniLibs/arm64-v8a/libtdjni.so
!/android/app/src/main/jniLibs/arm64-v8a/libcryptox.so
!/android/app/src/main/jniLibs/arm64-v8a/libsslx.so

# 正式签名材料：真品放在仓库之外，见 docs/release-signing.md。
# android/keystore.properties 只是本机构建用的副本，绝不能入库。
/android/keystore.properties
*.jks
*.keystore
*.pepk

# 本地工具状态与会话归档
_sessionzip/
.workbuddy/
.zcode/
.zcodeignore
# 宿主（PI-Desktop）生成的目标契约产物，每次会话都会重建。
.pi/

# 本地决策笔记不随源码分发；用户可见结论保存在 docs/。
# Note: .agents/notes/implemented/architecture/2026-09-25-project-directory-organization.md
.agents/

# 项目文档（含研究记录）只保留在本地，不入库不上传。
/docs/

# 代理执行入口含本地资料路径与内部判据编号，与 docs/ 同样只保留在本地。
/AGENTS.md

# TG影视库预置登录会话：完整的 Telegram 登录态，绝不提交。
# 构建期由转换脚本（本地）或 TG_SESSION_JSON_B64 密钥（CI）生成。
assets/tgdrama_session.json
