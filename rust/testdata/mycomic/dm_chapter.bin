    <script>
        // 优化的懒加载实现
        (function() {
            const lazyImages = document.querySelectorAll('img[data-src]');
            let loadingCount = 0;
            const maxConcurrent = 3; // 最多同时加载3张图片
            const loadQueue = [];

            // 图片加载队列管理
            function loadNextImage() {
                if (loadQueue.length === 0 || loadingCount >= maxConcurrent) {
                    return;
                }

                const img = loadQueue.shift();
                if (!img || img.src) return; // 已经加载过了

                loadingCount++;

                const tempImg = new Image();
                tempImg.onload = function() {
                    img.src = this.src;
                    img.classList.add('loaded');
                    img.classList.remove('lazy-image');
                    loadingCount--;
                    loadNextImage(); // 加载下一张
                };
                tempImg.onerror = function() {
                    img.classList.add('error');
                    img.classList.remove('lazy-image');
                    loadingCount--;
                    loadNextImage(); // 继续加载下一张
                };
                tempImg.src = img.dataset.src;
            }

            // IntersectionObserver 配置
            const imageObserver = new IntersectionObserver((entries, observer) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        const img = entry.target;

                        // 添加到加载队列
                        if (!loadQueue.includes(img) && !img.src) {
                            loadQueue.push(img);
                            loadNextImage();
                        }

                        // 停止观察已经进入视口的图片
                        observer.unobserve(img);
                    }
                });
            }, {
                rootMargin: '400px', // 提前400px开始加载
                threshold: 0.01
            });

            // 观察所有图片
            lazyImages.forEach(img => imageObserver.observe(img));

            // 页面加载完成后，立即加载前3张图片
            window.addEventListener('load', function() {
                const firstImages = Array.from(lazyImages).slice(0, 3);
                firstImages.forEach(img => {
                    if (!img.src) {
                        loadQueue.unshift(img); // 优先加载
                    }
                });
                loadNextImage();
                loadNextImage();
                loadNextImage();
            });
        })();
    </script>
