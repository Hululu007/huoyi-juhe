<!-- 阅读宽度调节：控制 .reader-img 的显示宽度（保持宽高比，不变形），偏好记忆到 localStorage。
     需放在包含 class="reader-img" 图片的页面中。 -->
<style>
    :root { --reader-w: 100%; }
    .reader-img {
        width: var(--reader-w, 100%);
        height: auto;
        display: block;
        margin-left: auto;
        margin-right: auto;
    }
    #readerZoom input[type=range] { accent-color: #ef4444; cursor: pointer; }
</style>
<div id="readerZoom" class="fixed right-3 bottom-20 z-50 flex items-center gap-2 bg-gray-800/90 text-gray-200 rounded-full pl-3 pr-2 py-1.5 shadow-lg backdrop-blur select-none">
    <button type="button" data-step="-10" class="w-6 h-6 flex items-center justify-center rounded-full hover:bg-gray-700 text-lg leading-none" aria-label="缩小">−</button>
    <input id="readerZoomRange" type="range" min="30" max="100" step="5" value="100" class="w-20 sm:w-28" aria-label="阅读宽度">
    <button type="button" data-step="10" class="w-6 h-6 flex items-center justify-center rounded-full hover:bg-gray-700 text-lg leading-none" aria-label="放大">+</button>
    <button id="readerZoomVal" type="button" class="text-xs w-10 text-center tabular-nums hover:text-white" title="点击恢复 100%">100%</button>
</div>
<script>
(function () {
    var KEY = 'reader_w';
    var root = document.documentElement;
    var range = document.getElementById('readerZoomRange');
    var val = document.getElementById('readerZoomVal');
    function clamp(v) { v = parseInt(v, 10) || 100; return Math.max(30, Math.min(100, v)); }
    function apply(v, save) {
        v = clamp(v);
        root.style.setProperty('--reader-w', v + '%');
        range.value = v;
        val.textContent = v + '%';
        if (save) { try { localStorage.setItem(KEY, v); } catch (e) {} }
    }
    var saved = 100;
    try { var s = localStorage.getItem(KEY); if (s) saved = clamp(s); } catch (e) {}
    apply(saved, false);
    range.addEventListener('input', function () { apply(range.value, true); });
    document.querySelectorAll('#readerZoom [data-step]').forEach(function (btn) {
        btn.addEventListener('click', function () {
            apply(clamp(range.value) + parseInt(btn.dataset.step, 10), true);
        });
    });
    val.addEventListener('click', function () { apply(100, true); });
})();
</script>

