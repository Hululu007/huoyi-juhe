n:k,tags:aQ,user:aR,latest_comic:aS,rank_change_type:b,rank_change_value:aT},{id:aU,title:aY,cover_image_url:aV,vertical_image_url:aW,square_image_url:aX,description:aZ,tags:a_,user:a$,latest_comic:ba,rank_change_type:b,rank_change_value:l},{id:bc,title:bf,cover_image_url:bd,vertical_image_url:be,square_image_url:d,description:bg,tags:bh,user:bi,latest_comic:bj,rank_change_type:b,rank_change_value:bk},{id:bl,title:bp,cover_image_url:bm,vertical_image_url:bn,square_image_url:bo,description:bq,tags:br,user:bs,latest_comic:bt,rank_change_type:b,rank_change_value:bu},{id:bv,title:bz,cover_image_url:bw,vertical_image_url:bx,square_image_url:by,description:bA,tags:bB,user:bC,latest_comic:bD,rank_change_type:b,rank_change_value:m},{id:bE,title:bI,cover_image_url:bF,vertical_image_url:bG,square_image_url:bH,description:bJ,tags:bK,user:bL,latest_comic:bM,rank_change_type:b,rank_change_value:j},{id:bN,title:bQ,cover_image_url:bO,vertical_image_url:bP,square_image_url:d,description:bR,tags:bS,user:bT,latest_comic:bU,rank_change_type:b,rank_change_value:l},{id:bV,title:bZ,cover_image_url:bW,vertical_image_url:bX,square_image_url:bY,description:b_,tags:b$,user:ca,latest_comic:cb,rank_change_type:b,rank_change_value:m},{id:cc,title:cf,cover_image_url:cd,vertical_image_url:ce,square_image_url:d,description:cg,tags:ch,user:ci,latest_comic:cj,rank_change_type:b,rank_change_value:i},{id:ck,title:co,cover_image_url:cl,vertical_image_url:cm,square_image_url:cn,description:cp,tags:cq,user:cr,latest_comic:cs,rank_change_type:b,rank_change_value:ct},{id:cu,title:cy,cover_image_url:cv,vertical_image_url:cw,square_image_url:cx,description:cz,tags:cA,user:cB,latest_comic:cC,rank_change_type:b,rank_change_value:cD},{id:cE,title:cI,cover_image_url:cF,vertical_image_url:cG,square_image_url:cH,description:cJ,tags:cK,user:cL,latest_comic:cM,rank_change_type:b,rank_change_value:cN}]},message:r},urlQuery:d,pro:n}],fetch:{},error:f,serverRendered:n,routePath:"\u002Franking\u002F9",config:{_app:{basePath:cO,assetsPath:cO,cdnURL:"https:\u002F\u002Fstatic3w.kuaikanmanhua.com\u002F_nuxt\u002F"}}}}(0,2,"签约作品","",false,null,9,"上升15名","新晋黑马","上升23名","仙子不仁，那就沦为炉鼎吧！","上升28名","上升31名",true,"0",200,"人气榜","ok",17212,"https:\u002F\u002Ftn1-f2.kkmh.com\u002Fimage\u002F230108\u002FlvZbRqysV.webp-w750.jpg","https:\u002F\u002Ftn1-f2.kkmh.com\u002Fimage\u002F230704\u002FTlvSmTVwB.webp-w320.w.jpg","https:\u002F\u002Ftn1-f2.kkmh.com\u002Fimage\u002F230108\u002FiWvBKNPUX.webp-w750.jpg","告白","痞帅深情飞行员周京泽x温软坚定医生许随。夏天永远热烈，我爱的少年也是。看“痴情浪子”周京泽演绎这一份情有独钟。【每周五更新|责编：小红】",Array(0),{},{},"上升22名",12602,"https:\u002F\u002Ftn1-f2.kkmh.com\u002Fimage\u002F210928\u002FXXkfelelu.webp-w750.jpg","https:\u002F\u002Ftn1-f2.kkmh.com\u002Fimage\u002F230704\u002FfGtGcCrin.webp-w320.w.jpg","https:\u002F\u002Ftn1-f2.kkmh.com\u002Fimage\u002F210928\u002FpzKQPyGjF.webp-w750.jpg","我！天命大反派","顾长歌穿越到玄幻世界，开局就拉满了模范主角、气运之子的仇恨值。\n不仅女主投怀送抱，还有令人眼红的贵客待遇。\n好在自己身份实力高人一筹，踩死一个小小的气运之子，还不简单？\n等等，这里还有个专门收割各路主角的系统？\n顾长歌微微一笑，看来这是要自己在天命大反派的路上越走越远啊！\n【独家\u002F责编：王莫失】",Array(0),{},{},"上升11名",27734,"https:\u002F\u002Ftn1-f2.kkmh.com\u002Fimage\u002F260529\u002FioMtkVYvZ.webp-w750.jpg","https:\u002F\u002Ftn1-f2.kkmh.com\u002Fimage\u002F260528\u002FMFONsTWWl.webp-w320.w.jpg","完美敌人","【超A女间谍】X【疯批冷血军火大佬】势均力敌，相爱相杀的对抗路情侣。\n为了完成复仇目的，荆夏潜伏在豪门大小姐身边做保镖。见到了大小姐的未婚夫——号称地下军火之王的霍楚沉后，怀疑、博弈、沦陷、挣扎……一场精彩绝伦的故事由此展开。【独家\u002F每周二更新】",Array(0),{},{},"上升7名",10698,"https:\u002F\u002Ftn1-f2.kkmh.com\u002Fimage\u002F260202\u002FRYRpEgUgY.webp-w750.jpg","https:\u002F\u002Ftn1-f2.kkmh.com\u002Fimage\u002F260202\u002FinWLDZDxl.webp-w320.w.jpg","https:\u002F\u002Ftn1-f2.kkmh.com\u002Fimage\u002F260202\u002FaqygFTvWK.webp-w750.jpg","这一世我要当至尊","十大封号武帝之一，绝世武帝古飞扬在天荡山脉陨落，于十五年后转世重生，化为天水国公子李云霄，开启了一场与当世无数天才相争锋的逆天之旅。武道九重，十方神境，从此整个世界暴走！【独家\u002F每周一更新；责编：春雨】",Array(0),{},{},531,"https:\u002F\u002Ftn1-f2.kkmh.com\u002Fimage\u002F180529\u002Fobta68yh7.webp-w750.jpg","https:\u002F\u002Ftn1-f2.kkmh.com\u002Fimage\u002F180529\u002Fcujlnna37.webp-w320.w.jpg","https:\u002F\u002Ftn1-f2.kkmh.com\u002Fimage\u002F190415\u002FRkL3VGoIm.webp-w750.jpg","非人哉","萌化后的神怪在人间，爆笑日常更新中【授权\u002F每周六更新 责编：小林酱】",Array(0),{},"https:\u002F\u002Ftn1-f2.kkmh.com\u002Fdefault_avatar_image.jpg-w180",{},11062,"https:\u002F\u002Ftn1-f2.kkmh.com\u002Fimage\u002F240722\u002F2CNcxtH2s.webp-w750.jpg","https:\u002F\u002Ftn1-f2.kkmh.com\u002Fimage\u002F240722\u002F6hjGdQjSB.webp-w320.w.jpg","https:\u002F\u002Ftn1-f2.kkmh.com\u002Fimage\u002F230217\u002FQDdRkxZgb.webp-w750.jpg","炮灰闺女的生存方式","叶七七一朝穿越，竟穿成暴君最不喜爱的小女儿，为了活命，她使出浑身解数远离暴君，命运却一次次将她推向残暴的君王身边，一不小心竟成了暴君的心尖宠？但宫廷之战，储位之争的序幕，却刚刚拉开……【独家\u002F每周一、二更新 责编：肥云】",Array(0),{},{},"上升18名",23352,"https:\u002F\u002Ftn1-f2.kkmh.com\u002Fimage\u002F240628\u002FlkKckTgMO.webp-w750.jpg","https:\u002F\u002Ftn1-f2.kkmh.com\u002Fimage\u002F240628\u002FFGokUeOiG.webp-w320.w.jpg","溯洄春时","女高中生栩听因为I人性格经常受到同学们的欺负，直到有一天，学校新来的修理工小哥出手救了她，英俊的外表和神秘的气质引起同学们的注意，栩听心怀感激，却在放学后的小树林撞见了他不可告人的秘密！？……【独家\u002F每周四更新    责编：33】",Array(0),{},{},12432,"https:\u002F\u002Ftn1-f2.kkmh.com\u002Fimage\u002F240430\u002FEEPhcWMYb.webp-w750.jpg","https:\u002F\u002Ftn1-f2.kkmh.com\u002Fimage\u002F240430\u002FInatlHsSD.webp-w320.w.jpg","https:\u002F\u002Ftn1-f2.kkmh.com\u002Fimage\u002F210910\u002FLCHaVEFDD.webp-w750.jpg","全球诡异时代","诡异复苏一百年的时间，人类只剩下十分之一，鬼的数量已经超过人类！\n为了生存，每个人从生下来开始，都需要选择一个“伴生鬼灵”，并不断培养自己的伴生鬼灵，以鬼制鬼。\n全球进入了与鬼共存的诡异时代！\n借助系统，林风培养出的无敌的鬼灵，整个世界都为之瑟瑟发抖！\n【责编：春雨】",Array(0),{},{},27325,"https:\u002F\u002Ftn1-f2.kkmh.com\u002Fimage\u002F260306\u002F6iUF00ENQ.webp-w750.jpg","https:\u002F\u002Ftn1-f2.kkmh.com\u002Fimage\u002F260306\u002FvBfN1ACeG.webp-w320.w.jpg",Array(0),{},{},"上升37名",23167,"https:\u002F\u002Ftn1-f2.kkmh.com\u002Fimage\u002F240607\u002FJnKajiQLm.webp-w750.jpg","https:\u002F\u002Ftn1-f2.kkmh.com\u002Fimage\u002F241212\u002FKfTAcwfAu.webp-w320.w.jpg","https:\u002F\u002Ftn1-f2.kkmh.com\u002Fimage\u002F240607\u002FqioxFUvDs.webp-w750.jpg","从哥布林到哥布林神","　林天转生成为哥布林，最低等的魔物，前期疯狂苟。 后期彻底释放哥布林的本性。 并且多子多福，哥布林受到的神明祝福，孩子越多实力越强！",Array(0),{},{},"本漫画每周五更新哦",3615,"https:\u002F\u002Ftn1-f2.kkmh.com\u002Fimage\u002F240202\u002FVNPAyEEAX.webp-w750.jpg","https:\u002F\u002Ftn1-f2.kkmh.com\u002Fimage\u002F240202\u002FXDxNqpOwm.webp-w320.w.jpg","魔皇大管家","魔皇卓一凡因得到上古魔帝传承，遭亲信背叛并引来杀身之祸。重生后修为归零的他又被心魔所困，不得不成为一个落寞家族大小姐的专属管家。从魔皇到小小管家，他究竟要怎样和自己的“心魔大小姐”相处，又如何才能带领这个没落家族和自己一起重回这片大陆的巅峰呢！【每周六更新两话  责编：金小明】",Array(0),{},{},"上升17名",17649,"https:\u002F\u002Ftn1-f2.kkmh.com\u002Fimage\u002F240528\u002FYWMKiGVlE.webp-w750.jpg","https:\u002F\u002Ftn1-f2.kkmh.com\u002Fimage\u002F240923\u002FCrOTyVIhX.webp-w320.w.jpg","https:\u002F\u002Ftn1-f2.kkmh.com\u002Fimage\u002F240528\u002FOBpljnYbf.webp-w750.jpg","全职剑修","在网游与现实合并的时代，《八荒》第一法修，悟道境巅峰玩家林霁尘,因爱人和兄弟的背叛，身死道消。 然而天不亡人，林霁尘重生回到《八荒》开服前一天。 重活一世，他毅然弃法从剑，用剑斩出未来，改写命运！ 也让他在游戏融入现实前，一骑绝尘！",Array(0),{},{},"上升36名",25260,"https:\u002F\u002Ftn1-f2.kkmh.com\u002Fimage\u002F260825\u002FYAZnMslsY.webp-w750.jpg","https:\u002F\u002Ftn1-f2.kkmh.com\u002Fimage\u002F260825\u002FbqUibACBG.webp-w320.w.jpg","https:\u002F\u002Ftn1-f2.kkmh.com\u002Fimage\u002F260825\u002FUgwPjsTtP.webp-w750.jpg","寻找恶女的契约丈夫","一场热病，让六岁的我觉醒——原来我是小说里恶女的女儿。\n我窥见了所有人的未来：我的母亲，身为世人唾弃的恶女，会被外祖父榨干所有价值，最后落得惨死的结局；而我自身，早已被不治之症缠上。我清楚自己终究无法挣脱病痛、逃不过死亡的宿命，那至少，我要拯救受尽苦难的可怜母亲。\n“妈妈，请好好活下去，替我幸福。“",Array(0),{},{},17161,"https:\u002F\u002Ftn1-f2.kkmh.com\u002Fimage\u002F230105\u002FDxocPDaov.webp-w750.jpg","https:\u002F\u002Ftn1-f2.kkmh.com\u002Fimage\u002F230105\u002FXTPSnDxOU.webp-w320.w.jpg","https:\u002F\u002Ftn1-f2.kkmh.com\u002Fimage\u002F230105\u002FWskNICTPq.webp-w750.jpg","登陆未来一万年","武道初兴之时，恐怖的异兽入侵，人类武者节节败退。陆圣穿越而来，在梦中进入一万年后的世界——\n一万年后的基础炼体术，经过改版，效果是现在的几千倍！一万年后的呼吸法、炼体药方、武学圣典……\n武道一万年，人类灭绝。\n繁衍至巅峰的武道文明，却再无人可继承。\n陆圣，便是那唯一的火种！\n【独家\u002F责编：春雨】",Array(0),{},{},18819,"https:\u002F\u002Ftn1-f2.kkmh.com\u002Fimage\u002F241107\u002FVTxzgqwiO.webp-w750.jpg","https:\u002F\u002Ftn1-f2.kkmh.com\u002Fimage\u002F241107\u002FXindKXGCZ.webp-w320.w.jpg","死灵法师！我即是天灾","游戏降临现实，世界规则颠覆，人类进入全民转职时代。\n唯有成为转职者！升级变强！方能站上世界之巅！\n转职当天，林默语成为唯一性隐藏职业，死灵法师。\n从此召唤物不死绝，林默语便不会死。\n“我高坐骸骨神座，行走生死之间。”\n“我即是天灾！”（独家\u002F每周日更新 责编：石桥）",Array(0),{},{},19109,"https:\u002F\u002Ftn1-f2.kkmh.com\u002Fimage\u002F230612\u002FtGmiLLXMV.webp-w750.jpg","https:\u002F\u002Ftn1-f2.kkmh.com\u002Fimage\u002F230612\u002FzafvAkPSF.webp-w320.w.jpg","https:\u002F\u002Ftn1-f2.kkmh.com\u002Fimage\u002F230612\u002FuQLDMYOvM.webp-w750.jpg","师尊：这个冲师逆徒才不是圣子","蓝星来的楚休百年前穿越到天穹大陆，绑定天命反派系统，斩圣地圣子生女无数，杀到同辈之中无敌。 最终，被老一辈强者围杀，自爆而亡，夺舍太素圣地云霞峰大弟子重生。 这一次，他决定“苟”起来，偷偷发育。 先定个小目标，成为一位万人敬仰的圣子如何？",Array(0),{},{},26010,"https:\u002F\u002Ftn1-f2.kkmh.com\u002Fimage\u002F250715\u002FUflMUzOrq.webp-w750.jpg","https:\u002F\u002Ftn1-f2.kkmh.com\u002Fimage\u002F250715\u002FtTAiBdKEB.webp-w320.w.jpg","好一个乖乖女","白切黑‘乖乖女’X深情豪门暴君，反套路双强CP甜撩来袭！\n女主鹿鸣于自幼父母双亡，在大伯家遭受长达十年的精神折磨与软禁，却凭借强大的内心伪装成乖乖女，暗中筹谋复仇。男主是清醒的恋爱脑贵公子，明知女主利用自己，却因一见钟情而甘愿付出，深情执着地守护女主……【独家\u002F每周三更新  责编：33】",Array(0),{},{},24375,"https:\u002F\u002Ftn1-f2.kkmh.com\u002Fimage\u002F241128\u002FfqddrvjaA.webp-w750.jpg","https:\u002F\u002Ftn1-f2.kkmh.com\u002Fimage\u002F241128\u002FjKiiUQDlv.webp-w320.w.jpg","https:\u002F\u002Ftn1-f2.kkmh.com\u002Fimage\u002F241128\u002FchZKzmsSp.webp-w750.jpg","伪装上流","“请卖掉我吧，我会成为全国身价最高的淑女！”\n正在发愁的公爵，在擦鞋摊上遇见了女扮男装的阿贝尔，于是决定签订3个月的兄妹合约，赢取政治的筹码……\n本以为可以就此摆脱被催着政治联姻的苦恼，没想到却常常被这个假妹妹牵动着身心。【独家\u002F责编：漠漠 每周二更新】",Array(0),{},{},"上升50名",25783,"https:\u002F\u002Ftn1-f2.kkmh.com\u002Fimage\u002F260918\u002FaAyagAxbM.webp-w750.jpg","https:\u002F\u002Ftn1-f2.kkmh.com\u002Fimage\u002F260918\u002FDPeVMAGOn.webp-w320.w.jpg","https:\u002F\u002Ftn1-f2.kkmh.com\u002Fimage\u002F260918\u002FJUbjFZJdc.webp-w750.jpg","沉溺于她","被渣男背叛后，为了报复，南枝借商界大佬傅寒州之势反击。渣男亲眼目睹两个人亲热，但畏惧傅寒洲的身份只好无能狂怒。本以为只是有限的合作，没想到渣男继续纠缠，南枝被迫一次次向傅寒州求救，而明明很有分寸的傅寒洲，却忍不住一次次极致护短，这场始于报复的成人游戏，渐渐失控了…",Array(0),{},{},"上升30名",9790,"https:\u002F\u002Ftn1-f2.kkmh.com\u002Fimage\u002F251128\u002FFhgBnvlKu.webp-w750.jpg","https:\u002F\u002Ftn1-f2.kkmh.com\u002Fimage\u002F251128\u002FYcxZBWhDw.webp-w320.w.jpg","https:\u002F\u002Ftn1-f2.kkmh.com\u002Fimage\u002F251128\u002FgfQsSPzcJ.webp-w750.jpg","橡树之下","天生性格内向、有些口吃的公爵家小姐，在父亲的强迫之下嫁给了平民出身的骑士。大婚之夜后就奔赴战场的丈夫，3年后成为了全大陆最知名的骑士，荣归故里。我似乎听到了他的呢喃，“这些年越想起你，越觉得自己很孤独。我想找到，为何如此痛苦却始终对你放心不下的原因。”【快看独家\u002F每周六更新 责编：小熊】",Array(0),{},{},"上升21名","\u002F"));</script><script src="https://static3w.kuaikanmanhua.com/_nuxt/static-kkfront-pc/app/runtime.6c9a21cb5778ff3cfa2f.js" defer></script><script src="https://static3w.kuaikanmanhua.com/_nuxt/static-kkfront-pc/chunk/pages/ranking/_id.788882d2b55194df2c85.js" defer></script><script src="https://static3w.kuaikanmanhua.com/_nuxt/static-kkfront-pc/chunk/vendors/components/index-discount-popup/components/index-welfare-pop/components/to-top/components/we/0d27d008.8f2155a2e638af29a3f9.js" defer></script><script src="https://static3w.kuaikanmanhua.com/_nuxt/static-kkfront-pc/chunk/vendors/components/index-discount-popup/components/index-welfare-pop/components/to-top/components/we/843ce6bf.c13da1b266ce902abb3d.js" defer></script><script src="https://static3w.kuaikanmanhua.com/_nuxt/static-kkfront-pc/chunk/pages/index/pages/pd/ipLicense/index/pages/pd/marketing/index/pages/prove/animationlist/index/pages//b4e5ea76.faf52342ccf81215ae45.js" defer></script><script src="https://static3w.kuaikanmanhua.com/_nuxt/static-kkfront-pc/chunk/pages/ranking/_id/pages/ranking/index/pages/tag/_id/pages/web/topic/_topicId/pages/webs/contact/inde/083bc707.6ece1b81be0117db474c.js" defer></script><script src="https://static3w.kuaikanmanhua.com/_nuxt/static-kkfront-pc/chunk/commons/app.82d755b2acc9df2b056d.js" defer></script><script src="https://static3w.kuaikanmanhua.com/_nuxt/static-kkfront-pc/chunk/vendors/app.27cfff5c7cbbfedc1660.js" defer></script><script src="https://static3w.kuaikanmanhua.com/_nuxt/static-kkfront-pc/chunk/app.05a79d4599833fc57c8b.js" defer></script>
