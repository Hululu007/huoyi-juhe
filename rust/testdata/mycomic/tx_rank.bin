    (function autoBlock() {
      // 拦截类型：页面、忽略、对话框（默认）
      var specBlockType = {
        'index': 'ignore',
        'chapter': 'ignore',
        'comic_info': 'ignore'
      };
      // 根据页面名称确定拦截类型，并做处理
      var blockType = specBlockType['rank'];
      // 微博里不适合跳转拦截页，强制改为弹窗
      if (/(^| )(Weibo)( |\/|$|\()/i.test(navigator.userAgent)) {
        blockType = null;
      }
      switch (blockType) {
        case 'page':
          new Blocker().checkAndGo();
          break;
        case 'ignore':
          break;
        default:
          new Blocker().checkAndDialog();
          break;
      }
    })();
  </script>
