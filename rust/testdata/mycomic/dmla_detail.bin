    </main>

    <script>
        // 章节排序功能
        (function() {
            const chapterList = document.getElementById('chapterList');
            if (!chapterList) return;

            // 获取所有章节元素
            let chapters = Array.from(chapterList.children);

            // 当前排序状态 (默认降序)
            let isDescending = true;

            // 更新按钮样式
            function updateButtonStyles(isDesc) {
                const buttons = {
                    desc: [document.getElementById('sortDesc'), document.getElementById('sortDescMobile')],
                    asc: [document.getElementById('sortAsc'), document.getElementById('sortAscMobile')]
                };

                buttons.desc.forEach(btn => {
                    if (btn) {
                        if (isDesc) {
                            btn.classList.remove('bg-gray-200', 'text-gray-700', 'hover:bg-gray-300');
                            btn.classList.add('bg-red-600', 'text-white');
                        } else {
                            btn.classList.remove('bg-red-600', 'text-white');
                            btn.classList.add('bg-gray-200', 'text-gray-700', 'hover:bg-gray-300');
                        }
                    }
                });

                buttons.asc.forEach(btn => {
                    if (btn) {
                        if (!isDesc) {
                            btn.classList.remove('bg-gray-200', 'text-gray-700', 'hover:bg-gray-300');
                            btn.classList.add('bg-red-600', 'text-white');
                        } else {
                            btn.classList.remove('bg-red-600', 'text-white');
                            btn.classList.add('bg-gray-200', 'text-gray-700', 'hover:bg-gray-300');
                        }
                    }
                });
            }

            // 排序章节
            function sortChapters(descending) {
                if (descending === isDescending) return; // 如果已经是当前排序，不重复操作

                isDescending = descending;

                // 反转数组
                chapters.reverse();

                // 清空列表
                chapterList.innerHTML = '';

                // 重新添加章节
                chapters.forEach(chapter => {
                    chapterList.appendChild(chapter);
                });

                // 更新按钮样式
                updateButtonStyles(isDescending);

                // 保存排序偏好到localStorage
                try {
                    localStorage.setItem('chapterSortOrder', isDescending ? 'desc' : 'asc');
                } catch (e) {
                    // 忽略localStorage错误
                }
            }

            // 绑定降序按钮
            const sortDescBtn = document.getElementById('sortDesc');
            const sortDescMobileBtn = document.getElementById('sortDescMobile');
            if (sortDescBtn) {
                sortDescBtn.addEventListener('click', function() {
                    sortChapters(true);
                });
            }
            if (sortDescMobileBtn) {
                sortDescMobileBtn.addEventListener('click', function() {
                    sortChapters(true);
                });
            }

            // 绑定升序按钮
            const sortAscBtn = document.getElementById('sortAsc');
            const sortAscMobileBtn = document.getElementById('sortAscMobile');
            if (sortAscBtn) {
                sortAscBtn.addEventListener('click', function() {
                    sortChapters(false);
                });
            }
            if (sortAscMobileBtn) {
                sortAscMobileBtn.addEventListener('click', function() {
                    sortChapters(false);
                });
            }

            // 页面加载时恢复用户的排序偏好
            try {
                const savedOrder = localStorage.getItem('chapterSortOrder');
                if (savedOrder === 'asc') {
                    sortChapters(false);
                }
            } catch (e) {
                // 忽略localStorage错误
            }
        })();
    </script>
